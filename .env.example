# Application Environment ("development" | "test" | "production")
APP_ENV=development
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL Connection (SQLAlchemy + psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/docfill

# Authentication (Week 0 Local-Dev Bypass vs Firebase Auth)
AUTH_DEV_BYPASS=true
AUTH_DEV_USER_EMAIL=dev@example.com
FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-adminsdk.json

# File Storage ("local" disk folder for dev/MVP, or "r2" for Cloudflare R2)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage

# Optional Advisory LLM (Ollama-compatible local server)
LLM_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
