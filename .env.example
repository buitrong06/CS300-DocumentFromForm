# Application
APP_ENV=development
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/omnidoc

# File Storage (local for MVP, or S3/R2 compatible)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage

# Authentication (Firebase)
FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-adminsdk.json

# Optional Advisory LLM (Ollama-compatible)
LLM_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
